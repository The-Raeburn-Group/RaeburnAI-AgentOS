APP_NAME="RaeburnAI AgentOS"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Human administrator authentication (OIDC / SSO)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"
AGENTOS_OIDC_ISSUER="https://identity.example.com"
AGENTOS_OIDC_CLIENT_ID="raeburnai-agentos"
AGENTOS_OIDC_CLIENT_SECRET="change-me"
# The verified tenant claim is interpreted in exactly one namespace.
# Use "id" when the IdP/Chain sends AgentOS Tenant.id values, or "slug"
# when it sends AgentOS Tenant.slug values. Never attempt both namespaces.
AGENTOS_TENANT_REFERENCE_MODE="id"
AGENTOS_OIDC_TENANT_CLAIM="tenant_id"
# Accepted roles: admin, operator, approver, auditor, viewer.
AGENTOS_OIDC_ROLES_CLAIM="roles"
# Human administrator JWT/session lifetime. Accepted range: 300-86400 seconds.
AGENTOS_SESSION_MAX_AGE_SECONDS="3600"

# Service-to-service workflow execution from RaeburnAI-Chain.
# Keep this separate from human OIDC credentials. Use the same secret as
# RAEBURN_AGENTOS_TOKEN in the Chain deployment. x-tenant-id is interpreted
# using AGENTOS_TENANT_REFERENCE_MODE.
RAEBURN_CHAIN_SERVICE_TOKEN="change-me-with-openssl-rand-base64-32"

# Database
DATABASE_URL="postgresql://agentos:agentos@localhost:5432/agentos?schema=public"

# Model providers - at least one cloud key or OLLAMA_BASE_URL is required for live runs
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_MODEL_PROVIDER="ollama"
DEFAULT_MODEL="llama3.1"

# Safety and execution limits
APPROVAL_REQUIRED_FOR_EXTERNAL_ACTIONS="true"
# Hard approval authorization lifetime. When this expires, the waiting workflow
# is cancelled fail-closed by the SLA reconciliation sweep.
APPROVAL_TTL_MINUTES="60"
# Decision SLA by risk. Breaching the SLA escalates the approval but does not
# execute or cancel the gated work unless the hard approval TTL also expires.
APPROVAL_SLA_LOW_MINUTES="480"
APPROVAL_SLA_MEDIUM_MINUTES="120"
APPROVAL_SLA_HIGH_MINUTES="30"
APPROVAL_SLA_CRITICAL_MINUTES="10"
# Logical owner labels shown in the approval inbox and written to audit evidence.
APPROVAL_ESCALATION_OWNER_LOW="operator"
APPROVAL_ESCALATION_OWNER_MEDIUM="operator"
APPROVAL_ESCALATION_OWNER_HIGH="approver"
APPROVAL_ESCALATION_OWNER_CRITICAL="admin"
MAX_AGENT_STEPS="12"
MAX_WORKFLOW_RUNTIME_SECONDS="900"
# Durable memory TTL. Writes default to 30 days and can never exceed the
# configured maximum; use the retention worker to purge expired rows.
MEMORY_DEFAULT_TTL_SECONDS="2592000"
MEMORY_MAX_TTL_SECONDS="31536000"
API_RATE_LIMIT_PER_MINUTE="60"

# Observability
LOG_LEVEL="info"
METRICS_ENABLED="true"

SPEND_DEFAULT_MAX_OUTPUT_TOKENS=4096
