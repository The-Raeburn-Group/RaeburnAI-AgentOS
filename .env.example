APP_NAME="RaeburnAI AgentOS"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Human administrator authentication (OIDC / SSO)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"
AGENTOS_OIDC_ISSUER="https://identity.example.com"
AGENTOS_OIDC_CLIENT_ID="raeburnai-agentos"
AGENTOS_OIDC_CLIENT_SECRET="change-me"
# The verified tenant claim must match an existing AgentOS Tenant.id or Tenant.slug.
AGENTOS_OIDC_TENANT_CLAIM="tenant_id"
# Accepted roles: admin, operator, approver, auditor, viewer.
AGENTOS_OIDC_ROLES_CLAIM="roles"
# Human administrator JWT/session lifetime. Accepted range: 300-86400 seconds.
AGENTOS_SESSION_MAX_AGE_SECONDS="3600"

# Service-to-service workflow execution from RaeburnAI-Chain.
# Keep this separate from human OIDC credentials. Use the same secret as
# RAEBURN_AGENTOS_TOKEN in the Chain deployment.
RAEBURN_CHAIN_SERVICE_TOKEN="change-me-with-openssl-rand-base64-32"

# Database
DATABASE_URL="postgresql://agentos:agentos@localhost:5432/agentos?schema=public"

# Model providers - at least one cloud key or OLLAMA_BASE_URL is required for live runs
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_MODEL_PROVIDER="ollama"
DEFAULT_MODEL="llama3.1"

# Safety and execution limits
APPROVAL_REQUIRED_FOR_EXTERNAL_ACTIONS="true"
MAX_AGENT_STEPS="12"
MAX_WORKFLOW_RUNTIME_SECONDS="900"
MEMORY_RETENTION_DAYS="365"
API_RATE_LIMIT_PER_MINUTE="60"

# Observability
LOG_LEVEL="info"
METRICS_ENABLED="true"
