generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  DRAFT
  VERIFIED
  DEPRECATED
}

enum RunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ApprovalRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkflowJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum EvaluationCandidateStatus {
  QUARANTINED
  APPROVED_EVALUATION
  APPROVED_TRAINING
  REJECTED
}

enum EvaluationCandidateTrigger {
  BENCHMARK_FAILURE
  HUMAN_CORRECTION
  TOOL_FAILURE
  LOW_CONFIDENCE
  SECURITY_EVENT
  MANUAL
}

enum EvaluationReviewDecision {
  APPROVE_EVALUATION
  APPROVE_TRAINING
  REJECT
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  agents      Agent[]
  workflows   Workflow[]
  runs        WorkflowRun[]
  tasks       AgentTask[]
  memories    Memory[]
  mcpServers  McpServer[]
  approvals   Approval[]
  auditEvents AuditEvent[]
  jobs                  WorkflowJob[]
  evaluationCandidates  EvaluationCandidate[]
  evaluationOccurrences EvaluationCandidateOccurrence[]
  evaluationReviews     EvaluationCandidateReview[]
}

model Agent {
  id               String      @id @default(uuid())
  tenantId         String
  name             String
  slug             String
  version          String      @default("0.1.0")
  description      String
  systemPrompt     String
  modelProvider    String      @default("ollama")
  modelName        String      @default("llama3.1")
  status           AgentStatus @default(DRAFT)
  marketplaceTags  String[]    @default([])
  requiredTools    String[]    @default([])
  approvalRequired Boolean     @default(true)
  memoryScope      String      @default("workspace")
  manifest         Json
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks            AgentTask[]

  @@unique([tenantId, slug, version])
  @@index([tenantId, status])
}

model Workflow {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  goal        String
  status      RunStatus     @default(QUEUED)
  graph       Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]
}

model WorkflowRun {
  id          String       @id @default(uuid())
  tenantId    String
  workflowId  String
  status      RunStatus    @default(QUEUED)
  input       Json
  output      Json?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow    Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks       AgentTask[]
  approvals   Approval[]
  events      AuditEvent[]
  job         WorkflowJob?

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model AgentTask {
  id          String       @id @default(uuid())
  tenantId    String
  runId       String
  agentId     String
  name        String
  status      RunStatus    @default(QUEUED)
  input       Json
  output      Json?
  error       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run         WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent       Agent        @relation(fields: [agentId], references: [id])

  @@index([tenantId, status])
}

model Memory {
  id          String   @id @default(uuid())
  tenantId    String
  scope       String
  kind        String   @default("context")
  key         String
  ownerKey    String   @default("__shared__")
  subjectId   String?
  content     String
  metadata    Json
  provenance  Json
  sensitivity String   @default("general")
  policyVersion String @default("raeburnai.memory-policy.v1")
  embedding   Float[]  @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, ownerKey, key])
  @@index([tenantId, subjectId, kind])
  @@index([tenantId, expiresAt])
}

model McpServer {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  url          String
  capabilities String[] @default([])
  enabled      Boolean  @default(false)
  policy       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model Approval {
  id              String         @id @default(uuid())
  tenantId        String
  runId           String
  actionType      String
  summary         String
  payload         Json
  status          ApprovalStatus @default(PENDING)
  risk            ApprovalRisk   @default(HIGH)
  requestedBy     String
  decidedBy       String?
  decisionNote    String?
  createdAt       DateTime       @default(now())
  expiresAt       DateTime?
  decidedAt       DateTime?
  slaDueAt        DateTime?
  escalationOwner String?
  escalationLevel Int            @default(0)
  escalatedAt     DateTime?
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run             WorkflowRun    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, risk, createdAt])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, status, slaDueAt])
  @@index([tenantId, status, escalationLevel])
}

model AuditEvent {
  id        String       @id @default(uuid())
  tenantId  String
  runId     String?
  actor     String
  action    String
  metadata  Json
  createdAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run       WorkflowRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([runId, createdAt])
}

model WorkflowJob {
  id             String            @id @default(uuid())
  tenantId       String
  idempotencyKey String
  payloadHash    String
  request        Json
  context        Json
  status         WorkflowJobStatus @default(QUEUED)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(3)
  availableAt    DateTime          @default(now())
  lockedAt       DateTime?
  leaseExpiresAt DateTime?
  lockedBy       String?
  lastError      String?
  runId          String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run            WorkflowRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([status, availableAt])
  @@index([tenantId, status])
  @@index([status, leaseExpiresAt])
}


model EvaluationCandidate {
  id                   String                     @id @default(uuid())
  tenantId             String
  fingerprint          String
  trigger              EvaluationCandidateTrigger
  task                 String
  domain               String
  prompt               String
  observedOutput       String?
  correction           String?
  confidence           Float?
  reasonLabels         String[]                   @default([])
  toolTrace            Json
  metadata             Json
  provenance           Json
  classification       String
  findingTypes         String[]                   @default([])
  redactionCount       Int                        @default(0)
  occurrenceCount      Int                        @default(1)
  status               EvaluationCandidateStatus  @default(QUARANTINED)
  approvedRecord       Json?
  approvedRecordDigest String?
  reviewedBy           String?
  reviewedAt           DateTime?
  firstSeenAt          DateTime                   @default(now())
  lastSeenAt           DateTime                   @default(now())
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrences          EvaluationCandidateOccurrence[]
  reviews              EvaluationCandidateReview[]

  @@unique([tenantId, fingerprint])
  @@unique([id, tenantId])
  @@index([tenantId, status, lastSeenAt])
  @@index([tenantId, trigger, lastSeenAt])
}

model EvaluationCandidateOccurrence {
  id            String              @id @default(uuid())
  tenantId      String
  candidateId   String
  sourceRefHash String
  actorId       String
  requestId     String
  createdAt     DateTime            @default(now())
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate     EvaluationCandidate @relation(fields: [candidateId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, candidateId, createdAt])
  @@index([tenantId, sourceRefHash])
}

model EvaluationCandidateReview {
  id            String                   @id @default(uuid())
  tenantId      String
  candidateId   String                   @unique
  reviewer      String
  decision      EvaluationReviewDecision
  note          String
  datasetRecord Json?
  recordDigest  String?
  createdAt     DateTime                 @default(now())
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate     EvaluationCandidate      @relation(fields: [candidateId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, createdAt])
}
