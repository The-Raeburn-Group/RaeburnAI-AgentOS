generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  DRAFT
  VERIFIED
  DEPRECATED
}

enum RunStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ApprovalRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkflowJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum EvaluationCandidateStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  PROMOTED
}

enum OptimizationExperimentStatus {
  EVALUATED
  APPROVED
  REJECTED
  PROMOTED
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  agents      Agent[]
  workflows   Workflow[]
  runs        WorkflowRun[]
  tasks       AgentTask[]
  memories    Memory[]
  mcpServers  McpServer[]
  approvals   Approval[]
  auditEvents          AuditEvent[]
  jobs                 WorkflowJob[]
  evaluationCandidates    EvaluationCandidate[]
  optimizationExperiments OptimizationExperiment[]
  usageEvents             UsageEvent[]
  spendReservations       SpendReservation[]
  budgetPolicy            BudgetPolicy?
}

model Agent {
  id               String      @id @default(uuid())
  tenantId         String
  name             String
  slug             String
  version          String      @default("0.1.0")
  description      String
  systemPrompt     String
  modelProvider    String      @default("ollama")
  modelName        String      @default("llama3.1")
  status           AgentStatus @default(DRAFT)
  marketplaceTags  String[]    @default([])
  requiredTools    String[]    @default([])
  approvalRequired Boolean     @default(true)
  memoryScope      String      @default("workspace")
  manifest         Json
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks                            AgentTask[]
  optimizationBaselineExperiments  OptimizationExperiment[] @relation("OptimizationBaseline")
  optimizationChallengerExperiments OptimizationExperiment[] @relation("OptimizationChallenger")

  @@unique([tenantId, slug, version])
  @@index([tenantId, status])
}

model Workflow {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  goal        String
  status      RunStatus     @default(QUEUED)
  graph       Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]
}

model WorkflowRun {
  id          String       @id @default(uuid())
  tenantId    String
  workflowId  String
  status      RunStatus    @default(QUEUED)
  input       Json
  output      Json?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow    Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks       AgentTask[]
  approvals   Approval[]
  events      AuditEvent[]
  job         WorkflowJob?

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model AgentTask {
  id          String       @id @default(uuid())
  tenantId    String
  runId       String
  agentId     String
  name        String
  status      RunStatus    @default(QUEUED)
  input       Json
  output      Json?
  error       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run         WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent       Agent        @relation(fields: [agentId], references: [id])

  @@index([tenantId, status])
}

model Memory {
  id          String   @id @default(uuid())
  tenantId    String
  scope       String
  kind        String   @default("context")
  key         String
  ownerKey    String   @default("__shared__")
  subjectId   String?
  content     String
  metadata    Json
  provenance  Json
  sensitivity String   @default("general")
  policyVersion String @default("raeburnai.memory-policy.v1")
  embedding   Float[]  @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, ownerKey, key])
  @@index([tenantId, subjectId, kind])
  @@index([tenantId, expiresAt])
}

model McpServer {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  url          String
  capabilities String[] @default([])
  enabled      Boolean  @default(false)
  policy       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model Approval {
  id              String         @id @default(uuid())
  tenantId        String
  runId           String
  actionType      String
  summary         String
  payload         Json
  status          ApprovalStatus @default(PENDING)
  risk            ApprovalRisk   @default(HIGH)
  requestedBy     String
  decidedBy       String?
  decisionNote    String?
  createdAt       DateTime       @default(now())
  expiresAt       DateTime?
  decidedAt       DateTime?
  slaDueAt        DateTime?
  escalationOwner String?
  escalationLevel Int            @default(0)
  escalatedAt     DateTime?
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run             WorkflowRun    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, risk, createdAt])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, status, slaDueAt])
  @@index([tenantId, status, escalationLevel])
}

model AuditEvent {
  id        String       @id @default(uuid())
  tenantId  String
  runId     String?
  actor     String
  action    String
  metadata  Json
  createdAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run                           WorkflowRun?                  @relation(fields: [runId], references: [id], onDelete: SetNull)
  evaluationCandidateOccurrence EvaluationCandidateOccurrence?

  @@index([tenantId, createdAt])
  @@index([runId, createdAt])
}

model WorkflowJob {
  id             String            @id @default(uuid())
  tenantId       String
  idempotencyKey String
  payloadHash    String
  request        Json
  context        Json
  status         WorkflowJobStatus @default(QUEUED)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(3)
  availableAt    DateTime          @default(now())
  lockedAt       DateTime?
  leaseExpiresAt DateTime?
  lockedBy       String?
  lastError      String?
  runId          String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run            WorkflowRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([status, availableAt])
  @@index([tenantId, status])
  @@index([status, leaseExpiresAt])
}


model EvaluationCandidate {
  id              String                    @id @default(uuid())
  tenantId        String
  fingerprint     String
  failureKind     String
  severity        String
  summary         String
  reasonLabels    String[]                  @default([])
  metadata        Json
  occurrenceCount Int                       @default(1)
  firstSeenAt     DateTime                  @default(now())
  lastSeenAt      DateTime                  @default(now())
  status          EvaluationCandidateStatus @default(PENDING_REVIEW)
  reviewedBy      String?
  reviewNote      String?
  reviewedAt      DateTime?
  datasetRecord   Json?
  promotedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrences     EvaluationCandidateOccurrence[]

  @@unique([tenantId, fingerprint])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, lastSeenAt])
}

model EvaluationCandidateOccurrence {
  id            String              @id @default(uuid())
  candidateId   String
  sourceEventId String              @unique
  createdAt     DateTime            @default(now())
  candidate     EvaluationCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sourceEvent   AuditEvent          @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}


model OptimizationExperiment {
  id                     String                       @id @default(uuid())
  tenantId               String
  baselineAgentId        String
  challengerAgentId      String
  baselineManifestDigest String
  challengerManifestDigest String
  artifactDigest         String
  policy                 Json
  evidence               Json
  result                 Json
  status                 OptimizationExperimentStatus @default(EVALUATED)
  createdBy              String
  reviewedBy             String?
  reviewNote             String?
  reviewedAt             DateTime?
  promotedAt             DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  tenant                 Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baselineAgent          Agent                        @relation("OptimizationBaseline", fields: [baselineAgentId], references: [id], onDelete: Restrict)
  challengerAgent        Agent                        @relation("OptimizationChallenger", fields: [challengerAgentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, artifactDigest])
  @@index([tenantId, status, createdAt])
  @@index([baselineAgentId])
  @@index([challengerAgentId])
}


model BudgetPolicy {
  id                     String   @id @default(uuid())
  tenantId               String   @unique
  currency               String   @default("USD")
  monthlyLimitMicrousd   BigInt?
  perRequestLimitMicrousd BigInt?
  warningRatio           Float    @default(0.8)
  enforcementMode        String   @default("hard")
  fallbackMode           String   @default("block")
  version                Int      @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model SpendReservation {
  id                       String   @id @default(uuid())
  tenantId                 String
  idempotencyKey           String
  payloadHash              String
  requestId                String
  actorId                  String
  estimatedCostMicrousd    BigInt
  committedCostMicrousd    BigInt?
  status                   String   @default("RESERVED")
  policyVersion            Int
  warning                  Boolean  @default(false)
  decisionReasons          String[] @default([])
  expiresAt                DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usageEvent               UsageEvent?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, requestId])
}

model UsageEvent {
  id              String   @id @default(uuid())
  tenantId        String
  reservationId   String?  @unique
  idempotencyKey  String
  requestId       String
  runId           String?
  actorId         String
  category        String
  provider        String?
  model           String?
  modelRegistryId String?
  expertSlug      String?
  toolName        String?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  latencyMs       Int?
  costMicrousd    BigInt   @default(0)
  billableMetric  String   @default("request")
  billableUnits   Int      @default(1)
  metadata        Json
  eventDigest     String
  occurredAt      DateTime
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation     SpendReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, occurredAt])
  @@index([tenantId, category, occurredAt])
  @@index([tenantId, requestId])
  @@index([tenantId, billableMetric, occurredAt])
}
